# ---------------------------------------------------------------------------
# Jarvis environment configuration
# Copy this file to `.env` and adjust the values for your machine:
#     cp .env.example .env
# `.env` is git-ignored and should never be committed.
# ---------------------------------------------------------------------------

# General
DEBUG=True
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# Paths (relative to the project root)
DATA_DIR=data
MODELS_DIR=data/models
KNOWN_FACES_DIR=data/known_faces
LOGS_DIR=data/logs

# Vision
CAMERA_INDEX=0                       # OpenCV camera index (0 = default webcam)
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FPS=30

# Audio
# Microphone / speakers: an index or part of the device name, e.g.
# AUDIO_INPUT_DEVICE=MacBook Pro Microphone. Blank = the macOS default
# (System Settings > Sound). List devices: python scripts/list_audio_devices.py
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
SAMPLE_RATE=16000
CHUNK_SIZE=1024

# Database
DATABASE_URL=sqlite:///data/jarvis.db

# ---------------------------------------------------------------------------
# Web / authentication  (read by jarvis/web/security.py)
# ---------------------------------------------------------------------------
# Signing key for JWT access tokens. If unset, a random key is generated and
# persisted to config/.secret_key. Set an explicit value in production.
JARVIS_SECRET_KEY=

# Initial dashboard login. If JARVIS_ADMIN_PASSWORD is unset, a default
# admin/admin account is seeded (with a warning) — DO NOT ship that.
JARVIS_ADMIN_USER=admin
JARVIS_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Conversation web search (optional). With both set, Google Custom Search is
# used; otherwise DuckDuckGo (no key needed, requires the `ddgs` package).
# Create a search engine at https://programmablesearchengine.google.com/
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ---------------------------------------------------------------------------
# Home Assistant  (device control + presence entities)
# Leave HA_URL or HA_TOKEN empty to disable the integration.
# Token: Home Assistant -> your profile -> Security -> Long-lived access tokens
# ---------------------------------------------------------------------------
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ---------------------------------------------------------------------------
# Frigate  (camera network awareness, via its MQTT broker)
# Leave MQTT_HOST empty to disable. Use the same broker/credentials as Frigate.
# FRIGATE_URL is optional; it is only used to build snapshot links.
# ---------------------------------------------------------------------------
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
FRIGATE_URL=http://frigate.local:5000
