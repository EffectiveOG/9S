{
    "web": {
        "host": "0.0.0.0",
        "port": 8000,
        "ssl": {
            "enabled": false,
            "cert_file": "config/ssl/cert.pem",
            "key_file": "config/ssl/key.pem"
        },
        "auth": {
            "enabled": true,
            "token_expiry_hours": 24,
            "allowed_ips": ["192.168.1.0/24"]
        },
        "cors": {
            "enabled": true,
            "allowed_origins": ["http://jarvis.local:3000"]
        }
    },
    "vision": {
        "camera_index": 0,
        "frame_size": [1280, 720],
        "show_preview": true,
        "yolo_model": "yolov8n.pt",
        "device": "mps",
        "flip_horizontal": true,    
        "flip_vertical": false,     
        "rotation": 0,           
        "preview_scale": 1.0,    
        "frame_skip": 2,
        "detect_objects": false,
        "detect_faces": true,
        "detect_gestures": true,
        "object_confidence": 0.25,
        "iou_threshold": 0.45,
        "performance": {
            "max_fps": 30,
            "power_mode": "balanced",
            "batch_size": 1
        },
        "backup": {
            "enabled": true,
            "interval_hours": 24,
            "max_backups": 7,
            "path": "data/backups/vision"
        }
    },
    "audio": {
        "sample_rate": 16000,
        "whisper_model": "base",
        "device": "cpu",
        "vad": {
            "enabled": true,
            "threshold": 0.3,
            "min_duration": 0.5,
            "max_duration": 10.0
        },
        "tts": {
            "voice": "en-US-Neural2-F",
            "rate": 1.0,
            "pitch": 1.0
        },
        "noise_reduction": {
            "enabled": true,
            "method": "spectral",
            "strength": 0.5
        },
        "wake_word": {
            "enabled": true,
            "phrase": "hey jarvis",
            "sensitivity": 0.8
        }
    },
    "memory": {
        "db_path": "data/jarvis.db",
        "retention_days": 30,
        "backup": {
            "enabled": true,
            "interval_hours": 24,
            "max_backups": 7
        },
        "compression": {
            "enabled": true,
            "method": "lz4"
        },
        "cache": {
            "enabled": true,
            "max_size_mb": 512,
            "ttl_minutes": 60
        }
    },
    "automation": {
        "scenes_file": "config/scenes.json",
        "default_timeout": 30,
        "retry_attempts": 3,
        "retry_delay": 1.0,
        "watchdog": {
            "enabled": true,
            "interval_seconds": 60,
            "max_failures": 3
        },
        "devices": [
            {
                "type": "home_assistant",
                "id": "living_room_tv",
                "entity_id": "media_player.living_room_tv",
                "inputs": {
                    "hdmi1": "HDMI 1",
                    "hdmi2": "HDMI 2",
                    "hdmi3": "HDMI 3"
                }
            },
            {
                "type": "home_assistant",
                "id": "living_room_lights",
                "entity_id": "light.living_room",
                "scenes": {
                    "default": "scene.living_room_default",
                    "movie": "scene.living_room_movie",
                    "relaxing": "scene.living_room_relaxing",
                    "gaming": "scene.living_room_gaming",
                    "gaming_intense": "scene.living_room_gaming_intense"
                }
            },
            {
                "type": "home_assistant",
                "id": "living_room_blinds",
                "entity_id": "cover.living_room"
            },
            {
                "type": "home_assistant",
                "id": "bedroom_lights",
                "entity_id": "light.bedroom",
                "scenes": {
                    "energizing": "scene.bedroom_energizing",
                    "relaxing": "scene.bedroom_relaxing"
                }
            },
            {
                "type": "home_assistant",
                "id": "kitchen_lights",
                "entity_id": "light.kitchen"
            },
            {
                "type": "home_assistant",
                "id": "ps5_console",
                "entity_id": "media_player.ps5"
            },
            {
                "type": "home_assistant",
                "id": "xbox_console",
                "entity_id": "media_player.xbox"
            }
        ],
        "error_handling": {
            "auto_retry": true,
            "max_retries": 3,
            "retry_delay": 1.0,
            "fallback_scenes": {
                "gaming_intense": "gaming_standard",
                "gaming_standard": "default"
            }
        },
        "notifications": {
            "enabled": true,
            "methods": ["console", "system"],
            "levels": ["error", "warning", "info"]
        }
    },
    "home_assistant": {
        "url": "${HA_URL}",
        "token": "${HA_TOKEN}",
        "reconnect_delay": 5,
        "request_timeout": 10
    },
    "frigate": {
        "mqtt": {
            "host": "${MQTT_HOST}",
            "port": 1883,
            "username": "${MQTT_USERNAME}",
            "password": "${MQTT_PASSWORD}",
            "client_id": "jarvis"
        },
        "topic_prefix": "frigate",
        "api_url": "${FRIGATE_URL}"
    },
    "awareness": {
        "ha_entities": ["person.*"],
        "max_tracked": 500
    },
    "system": {
        "logging": {
            "level": "INFO",
            "file": "data/logs/jarvis.log",
            "max_size_mb": 100,
            "backup_count": 5,
            "console_output": true
        },
        "performance": {
            "cpu_limit": 80,
            "memory_limit_mb": 2048,
            "gpu_memory_limit_mb": 1024
        },
        "maintenance": {
            "auto_update": {
                "enabled": true,
                "check_interval_hours": 24,
                "time_window": "03:00-05:00"
            },
            "cleanup": {
                "enabled": true,
                "interval_days": 7,
                "min_free_space_gb": 10
            }
        }
    }
}